# Buddy Builder settings. setup.sh / setup.bat copy this file to .env (which git ignores).
# Everything here is optional: without an AI key, Ask Buddy uses its offline parser.

# --- AI for the Ask Buddy chat (pick one provider) ---
# OpenAI or any OpenAI-compatible API:
BUDDY_LLM_PROVIDER=openai_compatible
BUDDY_LLM_API_KEY=
BUDDY_LLM_MODEL=gpt-6-luna
# BUDDY_LLM_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude) instead:
# BUDDY_LLM_PROVIDER=anthropic
# BUDDY_LLM_API_KEY=
# BUDDY_LLM_MODEL=claude-opus-5-5

# Speed and checking:
# BUDDY_LLM_REASONING=low        # low (fast, default) | medium | high | off
# BUDDY_AI_MODE=fast             # fast: one AI call per message (default); thorough: two
